{
  "name": "codeforge-website",
  "version": "8.3.0",
  "private": true,
  "type": "module",
  "description": "CodeForge website: React (Vite) front end + a small dependency-free Node server (Git CORS proxy, APK info, env-driven config).",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-site.mjs",
    "build:ui": "vite build",
    "start": "node server/index.js",
    "preview": "node scripts/build-site.mjs && node server/index.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jszip": "^3.10.1",
    "vite": "^5.4.8"
  }
}
